# Environment variables template for BizSproutAI Python Brain API
# Never commit real values. Production values belong in the runtime secret store.
OPENAI_API_KEY=your_openai_api_key_here
BRAIN_API_TOKEN=minimum_32_character_service_auth_secret
BRAIN_REQUEST_SIGNING_KEY=separate_minimum_32_character_request_signing_secret
PAYLOAD_ENCRYPTION_KEY=separate_minimum_32_character_payload_encryption_secret
OPENAI_TIMEOUT_SECONDS=45.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,https://bizsproutai.com,https://www.bizsproutai.com
OPENAI_MODEL=gpt-4o-mini
TRUST_PROXY_HEADERS=false
